# Copy to deploy/.env and chmod 600 deploy/.env before starting Compose.
# Generate a unique high-entropy value locally; do not commit the real .env.
BANKSIM_ADMIN_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
BANKSIM_ENGINE_VERSION=REPLACE_WITH_IMMUTABLE_RELEASE_ID
BANKSIM_SCENARIO_VERSION=public-catalogue-v1
BANKSIM_IMAGE_TAG=REPLACE_WITH_IMMUTABLE_IMAGE_TAG
BANKSIM_PORT=3000
BANKSIM_MAX_ADVANCE_MONTHS=12
BANKSIM_MAX_HORIZON_MONTHS=120
BANKSIM_REQUEST_RATE_LIMIT=120
LOG_LEVEL=info
