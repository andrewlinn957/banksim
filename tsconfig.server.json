{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "vitest/importMeta", "vite/client"],
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true
  },
  "include": ["server/**/*.ts", "src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "node_modules", "dist", "dist-server"]
}
